    "yellow": {
      "path": "tvui/icons/pointer-yellow-60",
      "width": 60,
      "height": 60,
      "offsetX": -20,
      "offsetY": 20
    },
    "blue": {
      "path": "tvui/icons/pointer-blue-60",
      "width": 60,
      "height": 60,
      "offsetX": -20,
      "offsetY": 20
    },
    "pink": {
      "path": "tvui/icons/pointer-pink-60",
      "width": 60,
      "height": 60,
      "offsetX": -20,
      "offsetY": 20
    }
  },
